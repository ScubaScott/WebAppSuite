# WebAppSuite Apache Configuration

# Ensure manifest.json is served with the correct PWA MIME type
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<Files "manifest.json">
    <IfModule mod_mime.c>
        ForceType application/manifest+json
    </IfModule>
</Files>

# Cache-Control headers to ensure code changes are validated with the server immediately
<IfModule mod_headers.c>
    # HTML, scripts, styles, and JSON configs should always revalidate on network
    <FilesMatch "\.(html|htm|js|css|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>

    # Service Worker and Web Manifest receive fresh responses without intermediate caching
    <FilesMatch "(sw\.js|manifest\.json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# URL Routing for API endpoints
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header to PHP environment in FastCGI/CGI setups
    <IfModule mod_authz_core.c>
        CGIPassAuth On
    </IfModule>
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route Bingo API endpoints
    RewriteRule ^api/health/?$ api/bingo.php?endpoint=health [QSA,L]
    RewriteRule ^api/cards/?$ api/bingo.php?endpoint=cards [QSA,L]
    RewriteRule ^api/cards/([^/]+)/?$ api/bingo.php?endpoint=cards&id=$1 [QSA,L]
    RewriteRule ^api/favorites/([^/]+)/?$ api/bingo.php?endpoint=favorites&id=$1 [QSA,L]
    RewriteRule ^api/games/?$ api/bingo.php?endpoint=games [QSA,L]
    RewriteRule ^api/games/([^/]+)/?$ api/bingo.php?endpoint=games&id=$1 [QSA,L]
</IfModule>

