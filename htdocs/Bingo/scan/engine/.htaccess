# Engine files are immutable: a new version is always a new file name, so browsers may keep them for a year.
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Pragma
    Header unset Expires

    # The manifest names the current files, so it is always revalidated
    <Files "manifest.json">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </Files>
</IfModule>

# Serve engine files as plain bytes (no automatic content encoding applied by the server defaults)
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/octet-stream .traineddata
    RemoveEncoding .gz
</IfModule>
